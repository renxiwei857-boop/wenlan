# OpenAI 配置
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek 配置示例（以下均为注释，不会生效）
# 使用时复制本文件为 backend/.env，并替换上方三个 OPENAI_* 配置值，避免重复定义。
# 本项目沿用 OPENAI_* 变量名连接 DeepSeek 的 OpenAI 兼容接口，无需修改源码。
# OPENAI_API_KEY=在本地填写你的 DeepSeek API Key，不要提交真实密钥
# OPENAI_API_BASE=https://api.deepseek.com
# OPENAI_MODEL=deepseek-flash
# 也可选择模型 deepseek-v4-pro，以官方文档和账号可用模型为准。
# 官方文档：https://api-docs.deepseek.com/

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# 数据库配置
DATABASE_URL=sqlite:///./data/wenlan_analytics.db
APP_DATABASE_URL=sqlite:///./wenlan_app.db

# 登录用户配置，格式: 用户名:密码:角色;用户名:密码:角色
AUTH_USERS=admin:admin123:admin;analyst:analyst123:analyst

# 查询与重试配置
MAX_RETRIES=3
QUERY_MAX_ROWS=1000
DATA_SOURCE_STATS_TTL_SECONDS=60

# 示例数据配置
SAMPLE_DATA_ROWS=1000
